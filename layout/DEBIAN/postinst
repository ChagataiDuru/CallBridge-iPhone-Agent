#!/bin/sh
set -e

PLIST=/var/jb/Library/LaunchDaemons/com.callbridge.agent.plist

if [ "$1" = "configure" ] || [ -z "$1" ]; then
  if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    launchctl load -w "$PLIST"
    echo "callbridge-agent is listening on port 8765."
    echo "Pair with: callbridge-agent --print-token"
  fi
fi

exit 0

# CallBridge local configuration and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
id_rsa*
id_ed25519*

# macOS and editor state
.DS_Store
._*
.AppleDouble
.LSOverride
*.swp
*.swo
*~
.idea/
.vscode/*.local.json

# Theos, compiler, and package outputs
.theos/
packages/
obj/
DerivedData/
.build/
compile_commands.json
*.dSYM/
*.dSYM.zip
*.ipa
*.deb
/*.plist

# Python/tool caches
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.coverage

# Private call evidence. Never commit raw phone numbers or conversations.
evidence/private/
evidence/**/*.caf
evidence/**/*.wav
evidence/**/*.m4a
evidence/**/*.mp3
evidence/**/*.pcm
evidence/**/*.aac

# Sanitized text evidence is intentionally reviewable and trackable.
!evidence/sanitized/**/*.log
!evidence/sanitized/**/*.txt
!evidence/sanitized/**/checksums.sha256

# Local device/static-analysis reports can contain names, IPs, and absolute paths.
reports/*
!reports/README.md
!reports/sanitized/
!reports/sanitized/**

# Extracted third-party applications and exploratory research stay local.
research/*
!research/README.md

# Binary packages and source archives stay in Actions or local storage.
artifacts/*
!artifacts/README.md

*.log
evidence/*
